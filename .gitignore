# --- Python ---
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/
env/

# Editable-install metadata, regenerated by `pip install -e .`
*.egg-info/
build/
dist/

# --- OS ---
.DS_Store
Thumbs.db

# --- Secrets ---
.env
*.key
*.pem
credentials.json

# --- Build output ---
# Staging is generated and published; never commit it.
_build_staging/
_build/

# --- Generated reports ---
# Audit reports list vault filenames, which may be confidential. Keep local.
reports/
audit_reports/

# --- Local config ---
# The real build config holds server paths; commit the example instead.
# NOTE: deliberately narrow. A blanket `*.yml` would also swallow
# .github/workflows/*.yml and any generated myst.yml.
/build_config.yml

# --- Local test vaults ---
# Research content must never be committed into this repo. A vault copied in
# here for testing is untracked, so a single `git add -A` would otherwise sweep
# it -- confidential folders included -- into git history permanently.
# Put test vaults in _vaults/ and they are covered automatically.
/_vaults/
/vaults/
/test_vault*/
/research-*/
/*_vault/

# --- Agent/editor local settings ---
# Claude Code writes a per-machine permission allow-list here. It holds no
# secrets, but it is local state (interpreter paths, one-off commands) and
# would otherwise be swept in by `git add -A`. A shared .claude/settings.json
# stays committable if the team ever wants one.
.claude/settings.local.json

# --- Editor ---
# Local interpreter selection is machine-specific: this checkout uses .venv on
# Windows, the server uses venv/ on Linux. Not shared.
.vscode/

# Local test config for eyeballing output with `myst start`.
/local_test_config.yml
