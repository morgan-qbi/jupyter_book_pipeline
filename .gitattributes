# Normalize line endings so a Windows checkout does not produce files that
# break on the Linux server.
* text=auto

# These are executed by Linux. CRLF in a shell script gives you
# "bad interpreter: /usr/bin/env bash^M", and systemd units are equally
# unforgiving. Force LF in the working tree on every platform.
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf

# The executable bit is NOT set by .gitattributes -- it lives in the tracked
# file mode (100755), applied once with `git update-index --chmod=+x`.
# On a Windows checkout also set `git config core.fileMode false`, or NTFS
# reports the bit as missing and git reverts it to 100644 -- which is how
# systemd ends up with Permission denied on ExecStart.
deploy/qbi-build.sh text eol=lf

# Binary assets git should not touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.stl binary
*.mp4 binary
*.mov binary
