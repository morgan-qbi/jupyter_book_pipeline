[Unit]
Description=Rebuild the QBI ELN site from the research vaults
# Ordering only: the build stops and starts the MyST service itself, so it must
# not be bound to it.
After=network.target

[Service]
Type=oneshot
ExecStart=/srv/qbi/jupyter-book-pipeline/deploy/qbi-build.sh

# Needs root (or a narrow sudoers rule) to stop and start the MyST unit.
User=root

# Override any of these without editing the script.
Environment=QBI_REPO=/srv/qbi/jupyter-book-pipeline
Environment=QBI_CONFIG=/srv/qbi/jupyter-book-pipeline/build_config.yml
Environment=QBI_STAGING=/srv/qbi/_build_staging
Environment=QBI_MYST_SERVICE=myst-eln

# A vault sync over thousands of files, with image re-encoding, can take a
# while on first run. Do not let systemd kill it mid-write.
#
# Six hours, not one. The first build after image optimization is enabled has
# to decode and re-encode every image already in the vaults -- tens of GB of
# full-size camera photos, hours of Pillow. Once the manifest exists only
# changed images are touched and a normal run is minutes, so this ceiling is
# sized for the one-time pass. Lower it once you have seen a steady-state
# build time you trust.
#
# Bounded rather than infinity on purpose: the site is down for the duration
# of a build, so a genuinely hung one has to fail eventually rather than stay
# down forever.
TimeoutStartSec=21600

# The site is down while this runs, so keep it off the CPU's critical path
# without letting it crawl.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
